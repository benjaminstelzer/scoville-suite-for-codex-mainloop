    "final_implementation_sources": {
      "simple": "\"\"\"Draft export code for the form editor.\"\"\"\nimport json\n\n\ndef collect_fields(records, wanted):\n    fields = {}\n    for record in records:\n        if record.get(\"disabled\", False):\n            continue\n        name = record[\"name\"].strip()\n        if name in wanted:\n            fields[name] = record[\"value\"]\n    return fields\n\n\ndef encode_fields(fields):\n    return json.dumps({\"version\": 2, \"fields\": fields}, sort_keys=True)\n\n\ndef decode_fields(text):\n    envelope = json.loads(text)\n    if not isinstance(envelope, dict) or set(envelope) != {\"version\", \"fields\"}:\n        raise ValueError(\"invalid fields envelope\")\n    if envelope[\"version\"] != 2:\n        raise ValueError(\"unsupported fields version\")\n    fields = envelope[\"fields\"]\n    if not isinstance(fields, dict) or any(\n        not isinstance(name, str) or not isinstance(value, str)\n        for name, value in fields.items()\n    ):\n        raise ValueError(\"invalid fields shape\")\n    return fields\n",
      "baseline": "\"\"\"Draft export code for the form editor.\"\"\"\nimport json\n\n\ndef collect_fields(records, wanted):\n    fields = {}\n    for record in records:\n        name = record[\"name\"].strip()\n        if record.get(\"disabled\") is not True and name in wanted:\n            fields[name] = record[\"value\"]\n    return fields\n\n\ndef encode_fields(fields):\n    return json.dumps({\"version\": 2, \"fields\": fields}, sort_keys=True)\n\n\ndef decode_fields(text):\n    envelope = json.loads(text)\n    if (\n        not isinstance(envelope, dict)\n        or set(envelope) != {\"version\", \"fields\"}\n        or type(envelope[\"version\"]) is not int\n        or envelope[\"version\"] != 2\n        or not isinstance(envelope[\"fields\"], dict)\n        or any(\n            not isinstance(name, str) or not isinstance(value, str)\n            for name, value in envelope[\"fields\"].items()\n        )\n    ):\n        raise ValueError(\"invalid version 2 fields envelope\")\n    return envelope[\"fields\"]\n",
      "candidate": "\"\"\"Draft export code for the form editor.\"\"\"\nimport json\n\n\ndef collect_fields(records, wanted):\n    fields = {}\n    for record in records:\n        if record.get(\"disabled\", False):\n            continue\n        name = record[\"name\"].strip()\n        if name in wanted:\n            fields[name] = record[\"value\"]\n    return fields\n\n\ndef encode_fields(fields):\n    return json.dumps({\"version\": 2, \"fields\": fields}, sort_keys=True)\n\n\ndef decode_fields(text):\n    envelope = json.loads(text)\n    if not isinstance(envelope, dict) or envelope.get(\"version\") != 2:\n        raise ValueError(\"unsupported or invalid fields format\")\n\n    fields = envelope.get(\"fields\")\n    if not isinstance(fields, dict) or any(\n        not isinstance(name, str) or not isinstance(value, str)\n        for name, value in fields.items()\n    ):\n        raise ValueError(\"fields must be an object mapping strings to strings\")\n    return fields\n"
